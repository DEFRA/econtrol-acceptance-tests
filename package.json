{
  "name": "econtrol-acceptance-tests",
  "version": "0.0.0",
  "type": "module",
  "description": "Sample WebdriverIO + Cucumber BDD + Allure reporting framework",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "test:dev": "cross-env TEST_ENV=dev wdio run wdio.conf.js --cucumberOpts.tagExpression='@endorsepermit'",
    "test:qa": "cross-env TEST_ENV=qa wdio run ./wdio.conf.js --cucumberOpts.tagExpression='@endorsepermit'",
    "test:api": "cross-env HEADLESS=true wdio run wdio.conf.js --cucumberOpts.tags='@search-permit-api'",
    "test:api:dev": "cross-env TEST_ENV=dev HEADLESS=true wdio run wdio.conf.js --cucumberOpts.tags='@search-permit-api'",
    "test:api:qa": "cross-env TEST_ENV=qa HEADLESS=true wdio run wdio.conf.js --cucumberOpts.tags='@endorse-permit-api'",
    "test": "wdio run wdio.github.conf.js",
    "test:smoke": "wdio run wdio.conf.js --cucumberOpts.tagExpression='@smoke'",
    "test:accessibility": "cross-env HEADLESS=true wdio run wdio.conf.js --cucumberOpts.tags='@accessibility'",
    "test:headless": "HEADLESS=true wdio run wdio.conf.js",
    "report": "allure generate ./allure-results --single-file --clean -o ./allure-report",
    "report:open": "allure open ./allure-report",
    "clean": "rm -rf allure-results allure-report",
    "test:github": "npm run clean && wdio run wdio.github.conf.js",
    "format": "prettier --write 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "format:check": "prettier --check 'test/**/*.js' '**/*.{js,md,json,config.js}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@axe-core/webdriverio": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@wdio/allure-reporter": "^9.9.0",
    "@wdio/cli": "^9.9.1",
    "@wdio/cucumber-framework": "^9.9.1",
    "@wdio/globals": "^9.9.1",
    "@wdio/local-runner": "^9.9.1",
    "@wdio/spec-reporter": "^9.9.0",
    "allure-commandline": "^2.32.0",
    "cross-env": "10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.3.0",
    "eslint-plugin-prettier": "5.5.5",
    "esm-module-alias": "2.2.1",
    "globals": "^16.0.0",
    "prettier": "^3.8.3"
  }
}
